{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordle-uptime",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "vars": {
    "BACKEND_STATUS_URL": "https://YOUR-SERVICE.onrender.com/health/status",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wordle-uptime",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
    {
      "binding": "guesszilla_uptime",
      "database_name": "guesszilla-uptime",
      "database_id": "6d493993-6c05-44fe-8937-8e2bf5e0539b",
      "remote": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
}
